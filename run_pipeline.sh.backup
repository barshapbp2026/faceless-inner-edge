#!/bin/bash
cd ~/faceless-factory
source venv/bin/activate
python3 scripts/day2_fix.py
ls "$PWD"/assets/norm_*.mp4 | sed "s|^|file '|;s|\$|'|" > assets/norm_clips.txt
ffmpeg -y -stream_loop -1 -f concat -safe 0 -i assets/norm_clips.txt -i output/voice.mp3 -t $(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 output/voice.mp3) -c:v libx264 -c:a aac -pix_fmt yuv420p output/final_video.mp4
python3 scripts/notify.py
echo "PIPELINE COMPLETE"

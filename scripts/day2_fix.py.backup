import os, asyncio, requests, subprocess, re, json
from groq import Groq
from dotenv import load_dotenv
import edge_tts

load_dotenv()

GROQ_API_KEY = os.getenv("GROQ_API_KEY")
PEXELS_API_KEY = os.getenv("PEXELS_API_KEY")
TOPIC = "The Mystery of Dark Matter"

# --- Generate Script ---
print(f"Generating script for: {TOPIC}...")
client = Groq(api_key=GROQ_API_KEY)
prompt = f"Write a 60-second script for a faceless YouTube Shorts video about {TOPIC}. Split it into exactly 4 distinct sentences. Output ONLY the sentences, nothing else."
chat_completion = client.chat.completions.create(messages=[{"role": "user", "content": prompt}], model="openai/gpt-oss-20b")
script = chat_completion.choices[0].message.content.strip()
sentences = [s.strip() for s in re.split(r'(?<=[.!?]) +', script) if s.strip()]

# --- Generate Voiceover ---
print("Generating AI voiceover...")
async def make_voice():
    communicate = edge_tts.Communicate(script, "en-US-GuyNeural")
    await communicate.save("output/voice.mp3")
asyncio.run(make_voice())

result = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", "output/voice.mp3"], stdout=subprocess.PIPE, text=True)
audio_duration = float(result.stdout.strip())
print(f"Voiceover duration: {audio_duration:.2f} seconds")

# --- Fetch Stock Footage (with error handling) ---
print("Fetching stock footage...")
headers = {"Authorization": PEXELS_API_KEY}
clip_files = []
for i, sentence in enumerate(sentences):
    clean_query = re.sub(r'[^\w\s]', '', sentence).split()
    query = " ".join(clean_query[:4])
    url = f"https://api.pexels.com/videos/search?query={query}&orientation=portrait&per_page=1"
    
    r = requests.get(url, headers=headers)
    data = r.json()
    
    # --- FIX: Check if the response contains videos ---
    if "videos" not in data or not data["videos"]:
        print(f"  No results for '{query}'. Falling back to 'space'...")
        url = "https://api.pexels.com/videos/search?query=space&orientation=portrait&per_page=1"
        r = requests.get(url, headers=headers)
        data = r.json()
    
    # --- FIX: Final safety check before accessing data ---
    if "videos" not in data or not data["videos"]:
        print(f"  ERROR: Could not find any video for sentence {i+1}. Response: {json.dumps(data)[:200]}")
        continue  # Skip this clip, but don't crash the whole script

    video_url = data["videos"][0]["video_files"][0]["link"]
    filepath = f"assets/clip_{i}.mp4"
    
    with open(filepath, "wb") as f:
        f.write(requests.get(video_url).content)
    
    clip_files.append(filepath)
    print(f"  Downloaded clip {i+1}/{len(sentences)}")

# --- Normalize and Assemble (only if we have clips) ---
if clip_files:
    print("Normalizing clips...")
    normalized_clips = []
    for i, clip in enumerate(clip_files):
        norm_path = f"assets/norm_{i}.mp4"
        subprocess.run(["ffmpeg", "-y", "-i", clip, "-vf", "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,fps=30", "-c:v", "libx264", "-an", norm_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        normalized_clips.append(norm_path)

    with open("assets/norm_clips.txt", "w") as f:
        for clip in normalized_clips:
            f.write(f"file '{clip}'\n")

    print("Assembling final video...")
    subprocess.run([
        "ffmpeg", "-y",
        "-stream_loop", "-1", "-f", "concat", "-safe", "0", "-i", "assets/norm_clips.txt",
        "-i", "output/voice.mp3",
        "-t", str(audio_duration),
        "-c:v", "libx264", "-c:a", "aac",
        "-pix_fmt", "yuv420p",
        "output/final_video.mp4"
    ])
    print("\nDONE! Your video is at: output/final_video.mp4")
else:
    print("\nERROR: No video clips were downloaded. Cannot assemble video.")
